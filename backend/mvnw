#!/bin/sh
# Maven wrapper — auto-downloads maven if not present
MAVEN_VERSION=3.9.6
MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  curl -fsSL "https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" | tar xz -C "$MAVEN_HOME" --strip 1
fi
exec "$MAVEN_HOME/bin/mvn" "$@"
